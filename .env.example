# PWF Auth Developer API Key
# Generated from https://pwfauth.com under Dashboard -> Developer API (ensure 'make keys' permission is enabled)
PWF_API_KEY=pwf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Upstash Redis (Used to prevent Work.ink token replay attacks & store optional pre-bound HWIDs)
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
